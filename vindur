import json
import urllib.request

URL = "https://api.vedur.is/weather/observations/aws/hour/latest?parameters=basic"
STOD = 1453   # Garðskagaviti


def saekja(url):
    beidni = urllib.request.Request(url, headers={"User-Agent": "currenttriangle (nam)"})
    with urllib.request.urlopen(beidni, timeout=20) as svar:
        return json.load(svar)


def finn(x, nr):
    """Skilar öllum orðabókum (dict) sem innihalda gildið nr."""
    nidurstodur = []
    if isinstance(x, dict):
        if any(v == nr or v == str(nr) for v in x.values()):
            nidurstodur.append(x)
        for v in x.values():
            nidurstodur += finn(v, nr)
    elif isinstance(x, list):
        for v in x:
            nidurstodur += finn(v, nr)
    return nidurstodur


if __name__ == "__main__":
    gogn = saekja(URL)

    print("Tegund:", type(gogn).__name__)
    if isinstance(gogn, dict):
        print("Lyklar:", list(gogn.keys()))
    elif isinstance(gogn, list):
        print("Fjöldi:", len(gogn))

    faerslur = finn(gogn, STOD)
    print(f"Fann {len(faerslur)} færslur fyrir stöð {STOD}")
    for f in faerslur[:3]:
        print(json.dumps(f, indent=2, ensure_ascii=False))

    if not faerslur:
        print("Byrjun svarsins:")
        print(json.dumps(gogn, indent=2, ensure_ascii=False)[:1500])